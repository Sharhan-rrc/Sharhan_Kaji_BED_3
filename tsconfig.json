{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",

    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "alwaysStrict": true,

    "baseUrl": "./",
    "paths": {
      "*": ["*"]
    }
  },

  "include": [
    "src/**/*",
    "config/**/*",
    "*.json"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}